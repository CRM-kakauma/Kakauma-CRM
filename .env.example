VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Somente no servidor — nunca commitar
SUPABASE_SERVICE_ROLE_KEY=

# --- CRM (projeto Supabase novo, só do CRM) ---
CRM_SUPABASE_URL=
CRM_SUPABASE_ANON_KEY=
# Somente no servidor — nunca commitar
CRM_SUPABASE_SERVICE_ROLE_KEY=
# Para `npm run crm:migrate` (Database → Connection string → Session pooler)
CRM_DATABASE_URL=
# Protege /api/webhooks/b4you (?token=...). Obrigatório em produção (Vercel).
B4YOU_WEBHOOK_TOKEN=
# Protege /api/cron/crm-process (Authorization: Bearer ...). A Vercel Cron envia sozinha.
CRON_SECRET=
# Opcional: canal real das automações (sem isso tudo fica como simulação)
CRM_AUTOMATION_WEBHOOK_URL=
CRM_AUTOMATION_WEBHOOK_SECRET=

# --- Pushfy (SMS / RCS) ---
# Token adicional criado no portal da Pushfy (API & Tokens → Novo token). Nunca o token principal.
PUSHFY_API_TOKEN=
# Só com "true" o CRM envia para clientes de verdade. Sem isso: simulação (o "Enviar teste" funciona).
PUSHFY_LIVE=
# Opcional: nome do remetente do SMS
PUSHFY_SMS_FROM=
# Segredo do webhook de status/respostas (cadastre .../api/webhooks/pushfy?token=ESTE_VALOR no painel da Pushfy)
PUSHFY_WEBHOOK_TOKEN=

# --- E-mail (Resend) ---
# Chave da API (resend.com → API Keys, permissão "Sending access")
RESEND_API_KEY=
# Remetente num domínio verificado no Resend (ex.: contato@kakauma.com.br)
EMAIL_FROM=
# Opcional: para onde vão as respostas
EMAIL_REPLY_TO=
# Só com "true" os fluxos mandam e-mails para clientes de verdade (testes saem sempre)
EMAIL_LIVE=

# Optional: short domain for the link shortener (/l/<code>), pointing to this same Vercel project.
# Without it, short links use the CRM's own address. Example: https://k.kakauma.com.br
VITE_SHORT_LINK_BASE=

# Click tracking: store links in sent messages become <base>/l/<code> (counts the click, then opens
# the page with its UTMs). With a domain of the brand pointing to this project, e-mails are tracked
# too; without it, the project's Vercel address is used for SMS/RCS only. false = off.
CRM_LINK_BASE=
CRM_LINK_TRACKING=
# The CRM's own address (needed outside Vercel, e.g. on Cloudflare: https://<worker>.<account>.workers.dev).
# Used for SMS/RCS/WhatsApp short links when CRM_LINK_BASE is not set. On Vercel it comes by itself.
CRM_APP_URL=

# Resend webhook (e-mail delivered / opened / clicked / bounced / spam): signing secret (whsec_…)
# of the endpoint https://<crm>/api/webhooks/resend created in Resend → Webhooks.
RESEND_WEBHOOK_SECRET=

# WhatsApp through Evolution API (unofficial; takes the place of the official API when set).
# EVOLUTION_API_URL = address of your Evolution server (https://…), EVOLUTION_API_KEY = its global
# apikey (AUTHENTICATION_API_KEY), EVOLUTION_INSTANCE = the instance name. EVOLUTION_WEBHOOK_TOKEN:
# a password you invent; Operação → "Cadastrar webhook na Evolution" registers
# https://<crm>/api/webhooks/evolution?token=… in the instance. WHATSAPP_LIVE=true sends for real.
# EVOLUTION_DELAY_MS (optional): ms of "digitando…" before each message.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=
EVOLUTION_DELAY_MS=

# WhatsApp official (Meta Cloud API) — used only when Evolution is not configured. Phone number ID and WhatsApp Business account (WABA) ID from
# developers.facebook.com → app → WhatsApp → API setup; a system user's permanent token
# (whatsapp_business_messaging + whatsapp_business_management). WHATSAPP_LIVE=true sends for real
# from flows (tests go out before that). Webhook https://<crm>/api/webhooks/whatsapp: "Verify token"
# = WHATSAPP_VERIFY_TOKEN; signatures checked with the app secret.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_LIVE=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# optional, default v23.0
WHATSAPP_API_VERSION=
